import streamlit as st
import asyncio
import json
from streamlit.runtime.scriptrunner import add_script_run_ctx

# === IMPORTS FROM YOUR PROJECT ===
from your_file import build_graph, stream_graph_response, AgentState
from langgraph.prebuilt import ToolCall


# =======================
# STREAMLIT PAGE CONFIG
# =======================
st.set_page_config(page_title="Agent Console", layout="wide")

if "messages" not in st.session_state:
    st.session_state.messages = []

if "yolo" not in st.session_state:
    st.session_state.yolo = False


# ======================
# ASYNC STREAM HANDLER
# ======================
async def handle_agent_stream(user_input):
    graph = await build_graph()

    st.session_state.messages.append({"role": "user", "content": user_input})

    ai_placeholder = st.empty()
    tool_placeholder = st.empty()
    final_ai_response = ""

    async for chunk in stream_graph_response(
            graph=graph,
            input=AgentState(
                messages=[{"role": "user", "content": user_input}],
                yolo_mode=st.session_state.yolo
            )
        ):

        # Normal assistant text
        if isinstance(chunk, str):
            final_ai_response += chunk
            ai_placeholder.markdown(f"**Assistant:** {final_ai_response}")

        # Tool call
        elif isinstance(chunk, ToolCall):
            tool_placeholder.code(json.dumps({
                "tool": chunk.name,
                "args": chunk.args
            }, indent=2))

    st.session_state.messages.append(
        {"role": "assistant", "content": final_ai_response}
    )


# ============================
# STREAMLIT CHAT UI
# ============================
st.title("🧠 Agent Console (Streamlit)")

# YOLO MODE
st.session_state.yolo = st.checkbox("YOLO Mode (auto approve interruptions)", value=False)


# SHOW CHAT HISTORY
for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.write(msg["content"])


# USER INPUT BOX
user_input = st.chat_input("Type your message...")

# PROCESS INPUT
if user_input:
    st.chat_message("user").write(user_input)

    # Run event loop inside Streamlit
    loop = asyncio.new_event_loop()
    add_script_run_ctx(loop)
    loop.run_until_complete(handle_agent_stream(user_input))
